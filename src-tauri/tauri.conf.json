{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rebase",
  "version": "0.1.0",
  "identifier": "host.kregel.rebase",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["rebase"]
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "rebase",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
